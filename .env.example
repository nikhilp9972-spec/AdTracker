# ========================================================
# Competitor Ad Tracker & Intelligence Engine - Configuration
# ========================================================

# Server Port & Host
HOST=127.0.0.1
PORT=8000

# Automated Weekly Schedule
# Runs the end-to-end pipeline (Ad Ingestion -> AI Summary -> Slack/Email Post)
SCHEDULE_ENABLED=true
SCHEDULE_DAY=monday
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Slack Incoming Webhook
# Paste your webhook URL here to automatically deliver digests to your channel
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here

# Email Delivery (SMTP)
# Configure SMTP credentials to send responsive HTML email newsletters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Competitor Ad Tracker <your-email@gmail.com>"
EMAIL_RECIPIENTS=growth@company.com,cmo@company.com

# Optional AI Providers (Leave blank to use intelligent built-in NLP heuristics)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=auto

# Optional Meta Ad Library API Token
META_ACCESS_TOKEN=
